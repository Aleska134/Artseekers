# Back-End Configuration
# DATABASE_URL=postgres://gitpod:postgres@localhost:5432/example
FLASK_APP_KEY="any key works"
FLASK_APP=src/app.py
FLASK_DEBUG=1
JWT_SECRET_KEY=replace_with_a_long_random_string

# Database URL
# For local development, you can leave this empty or use a simple sqlite path.
# The app is configured to automatically create the absolute path in src/instance/test.db
DATABASE_URL=sqlite:///test.db

# For production (PostgreSQL) use the format:
# DATABASE_URL=postgres://user:password@hostname:port/dbname

# --- EXTERNAL APIS ---
# AI curator uses Google Gemini (vision). Get a free key at:
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here

# Front-End Configuration
BACKEND_URL=http://localhost:3001
# Router basename (leave empty unless the app is served from a sub-path)
BASENAME=